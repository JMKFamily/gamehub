 "calib_check_hz": 1046.5,
 "melody": {
  "_rule": "레벨별 2마디 동기(levels.NN.motif). 자리 s = 2마디 틀 안 8분 자리(0~7 = 홀수 번째 마디, 8~15 = 짝수 번째 마디), d = 그 레벨 음계 도수(0 = 근음3×octave_mul, 음계 길이를 넘으면 한 옥타브 위), len = 8분 개수(음 길이). 마디 b(레벨 마디 번호, 카운트인 제외 0부터)는 b % frame_bars 번째 반쪽을 쓴다. 따라 치기 마디이면서 진행 단계 ≥ from_stage 일 때만 울림(보여 주기·쉬는·카운트인 마디는 끔). 그 마디 판정 별 자리와 같은 자리면 avoid_star.try 순서(같은 마디 안 0~7, 별·다른 멜로디 음이 없는 자리)로 옮기고, 없으면 그 음을 뺀다. 악기 = melody[동기 음 번호 % 악기 수]. 화음 = 진행 단계 ≥ harmony.from_stage 에서 d + deg_plus 를 sounds.harmony_db 로 같이. outro 첫 마디 자리 0 에 도수 0, outro_len 8분.",
  "octave_mul": 2,
  "frame_bars": 2,
  "frame_slots": 16,
  "max_degree": 7,
  "max_len": 4,
  "from_stage": 2,
  "avoid_star": {
   "try": [
    0,
    -1,
    1
   ],
   "same_bar_only": true,
   "else": "drop"
  },
  "harmony": {
   "from_stage": 3,
   "deg_plus": 2
  },
  "outro": {
   "slot": 0,
   "d": 0,
   "len": 4
  },
  "instrument_pick": "motif_note_index_mod"
 },
 "melody_r3": {
  "_rule": "round-3 레벨 스키마 v3(보여 주기 마디 없음)용 멜로디 배치. 규칙은 music.melody 와 같고(2마디 동기, 별 자리면 같은 마디 안 0 → −1 → +1로 옮기고 안 되면 뺌, 악기·화음·outro 같음) 바뀌는 것 둘: ① 울리는 마디 = 카운트인·outro를 뺀 모든 마디 중 진행 단계 ≥ from_stage(보여 주기 마디가 없어짐). 숨 고르기(2~4박 빈 자리)에도 멜로디는 이어짐(곡이 2박마다 끊기지 않게, 빈 자리를 멜로디가 채움) ② 별 자리 = 레벨의 모든 판정 별(마디 경계를 넘는 덩어리, 자유 시작 박 포함). 마디 번호 b·자리 0~7은 카운트인 뒤 첫 마디부터 센 8분 격자. 레벨 파일이 schema_version 3 이상이면 빌드와 sound-check가 이 규칙을 씀(v2 레벨은 music.melody 그대로)",
  "from_stage": 2,
  "during_breath": "play",
  "avoid_star": {
   "try": [
    0,
    -1,
    1
   ],
   "same_bar_only": true,
   "else": "drop"
  }
 },
 "combo_r3": {
  "_rule": "round-3 콤보 단계 소리(30-art 16-4, harness/benchmarks/djmax-judgement.md 4-4·5-2). 콤보가 10·20·30이 되는 판정 순간에 바로 울리지 않고, 그 판정 별 시각 + min_after_beats 이후 첫 정박(마디 안 짝수 8분 자리) 중 판정 별이 없는 자리에 예약. max_wait_beats 안에 빈 정박이 없으면(L1처럼 박마다 별) 같은 범위의 빈 반박 자리(fallback_any_eighth), 그것도 없으면 소리 없이 넘김(그림 연출은 그대로). 실패로 시도가 끝나면 아직 울리지 않은 예약은 취소. 끊김(실패)은 소리 없음. 콤보 1~9·11~19의 갱신, 5 단계는 소리 없음(판정 소리가 이미 등급을 알려 줌)",
  "steps": {
   "10": "combo_10",
   "20": "combo_20",
   "30": "combo_20"
  },
  "min_after_beats": 0.5,
  "max_wait_beats": 2,
  "slot_grid": "even_eighths",
  "avoid_star": true,
  "break_sound": null,
  "fallback_any_eighth": true
 }
}
