 },
 "rule": {
  "judge_x_frac": {
   "landscape": 0.3,
   "portrait": 0.2
  },
  "road_y_frac": {
   "landscape": 0.48,
   "portrait": 0.4
  },
  "star_d_frac_of_short_side": 0.1,
  "half_gap_px": 8,
  "road_h_mul": 1.6,
  "ball_d_mul": 0.8,
  "ball_d_min": 24,
  "ball_gap_px": 2,
  "ball_bounce_mul": 0.5,
  "drum_r_mul": 0.7,
  "drum_gap_px": 6,
  "line_w": "(d) => Math.max(6, Math.round(d / 8))",
  "fx_grow": {
   "perfect": 1.2,
   "good": 1.1
  },
  "finger_cell": "(d) => Math.max(64, Math.round(1.6 * d))",
  "finger_gap_px": 8,
  "text_slot": {
   "w_max": 220,
   "h": 40,
   "gap": 8
  },
  "hud": {
   "bar_y": {
    "portrait": 24,
    "landscape": 20
   },
   "bar_h": 10,
   "attempt_dy": 14,
   "attempt_r": 4.5,
   "pause": 48,
   "pause_margin": 12
  },
  "combo": {
   "dy_from_attempt": 16,
   "dot_r": 4,
   "dot_pitch": 12,
   "cells": 10,
   "mark_r": 6,
   "mark_pitch": 16,
   "marks_max": 3,
   "x0": 16
  },
  "hud_band_pad": 6,
  "thumb": {
   "top_frac": 0.7,
   "gap": 12,
   "bottom_margin": 16
  },
  "margin": 16
 },
 "formulas": {
  "judge_x": "safeL + judge_x_frac[o] × (W − safeL − safeR)",
  "preview_px": "W − safeR − judge_x (별 중심이 오른쪽 끝에 올 때부터 판정 선까지). 별은 중심 x = W + r 에서 생겨 화면 밖에서 미끄러져 들어옴(갑자기 나타나지 않음)",
  "speed": "preview_px ÷ (lead_beats × 60/BPM) px/s, 레벨 안 고정. 별 x(t) = judge_x + speed × (별 시각 − 지금), 지금 = 판정과 같은 보정 시계",
  "star_d": "floor(min(0.10 × 짧은 변, preview_px ÷ (2 × 반박 레벨 중 가장 긴 lead_beats) − 8))",
  "overlap_ms": "(star_d + line_w) ÷ speed"
 },
 "text_slots": {
  "tut_tap": "layouts[].text_slot (가로 = 손가락 칸 오른쪽, 세로 = 손가락 칸 아래). 가장 긴 언어로 2줄 안에 들어가야 하고 넘치면 글자 14 → 12 px, 그래도 넘치면 lore 문구 요청"
 },
