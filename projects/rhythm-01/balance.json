   ]
  },
  "music_fade_out_s": 0.08,
  "fail_fx_s": 0.3,
  "settle_s": 0.58,
  "regrow_s": 0.2,
  "ball_return": "regrow_at_top",
  "ball_regrow_scale": [
   0.6,
   1
  ],
  "nod": false,
  "best_record_slide_s": 0.2,
  "count_in_bars": 1,
  "count_in_ticks": "every_beat",
  "new_stars_appear": "during_count_in_by_preview_rule",
  "_note": "실패 순간(깨진 별 시각) → 공이 다시 움직이는 첫 프레임 = 1.08 s, 자동. 0~0.08 음악 페이드 / 0~0.30 별 깨짐 + 공이 속 빈 원 / 0.30~0.88 정지(진행도 막대 최고 기록 0.2 s 미끄러짐) / 0.88~1.08 12시에서 공이 0.6→1.0배로 커지며 다시 나타남(거꾸로 미끄러지지 않음). 1.08 s 에 카운트인 1마디 시작. 첫 마디 별은 카운트인 중 preview 규칙으로 커지며 나타남 (결정 5, 20-balance.md 6-1)."
 },
