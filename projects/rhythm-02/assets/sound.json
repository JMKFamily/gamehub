  "onset_rule": {
   "_def": "b = 레벨 박(정수, 레벨 시간 0 = 첫 받침 쉼 첫 박, 마디 = meter 박, 박 0 = 마디 첫 박). 받침 쉼 구절 = levels phrases[] [start_beat, start_beat + rest_beats).",
   "rest": {
    "every_beat": true,
    "even_k": "rest_a",
    "odd_k": "rest_b",
    "k": "b − 그 받침 쉼 start_beat",
